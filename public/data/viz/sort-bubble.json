  "code": "void bubbleSort(int a[], int n) {\n    for (int i = 0; i < n - 1; i++) {          /* 共 n-1 趟 */\n        for (int j = 0; j < n - 1 - i; j++) {   /* 每趟两两比较 */\n            if (a[j] > a[j + 1]) {              /* 逆序则交换，把大值后移 */\n                int t = a[j];\n                a[j] = a[j + 1];\n                a[j + 1] = t;\n            }\n        }\n    }\n}",
