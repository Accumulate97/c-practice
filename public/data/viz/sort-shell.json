  "code": "void shellSort(int a[], int n) {\n    for (int gap = n / 2; gap >= 1; gap /= 2) {  /* 增量逐次减半 */\n        for (int i = gap; i < n; i++) {\n            int key = a[i];\n            int j = i;\n            while (j >= gap && a[j - gap] > key) {\n                a[j] = a[j - gap];              /* 间隔 gap 的插入排序 */\n                j -= gap;\n            }\n            a[j] = key;\n        }\n    }\n}",
