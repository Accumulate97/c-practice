  "code": "void insertionSort(int a[], int n) {\n    for (int i = 1; i < n; i++) {\n        int key = a[i];                         /* 待插入元素 */\n        int j = i - 1;\n        while (j >= 0 && a[j] > key) {          /* 比 key 大的都右移 */\n            a[j + 1] = a[j];\n            j--;\n        }\n        a[j + 1] = key;                         /* 落位 */\n    }\n}",
