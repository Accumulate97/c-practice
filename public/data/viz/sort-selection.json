  "code": "void selectionSort(int a[], int n) {\n    for (int i = 0; i < n - 1; i++) {\n        int min = i;                            /* 记录最小值下标 */\n        for (int j = i + 1; j < n; j++)\n            if (a[j] < a[min]) min = j;\n        if (min != i) {                         /* 把最小值换到 a[i] */\n            int t = a[i]; a[i] = a[min]; a[min] = t;\n        }\n    }\n}",
