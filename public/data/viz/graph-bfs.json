  "relatedProblems": [],
  "code": "void bfs(int start, int n, const int adj[][n], int visited[]) {\n    int queue[n], front = 0, rear = 0;\n    visited[start] = 1;\n    queue[rear++] = start;              /* 起点入队 */\n    while (front < rear) {\n        int u = queue[front++];         /* 出队 */\n        for (int v = 0; v < n; v++)\n            if (adj[u][v] && !visited[v]) {\n                visited[v] = 1;\n                queue[rear++] = v;      /* 未访问邻居入队 */\n            }\n    }\n}",
