{
  "name": "c-practice",
  "description": "C 语言 + 数据结构在线学习平台（知识点 / 可视化演示 / 在线刷题），纯静态站点",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:index": "node scripts/build-index.ts",
    "dev": "vite",
    "judge:verify": "node scripts/judge-verify.ts",
    "lint:code": "node scripts/lint-code.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:data": "node scripts/verify-data.ts",
    "verify:pages": "node scripts/verify-pages-dist.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
