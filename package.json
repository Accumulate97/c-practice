{
  "name": "c-practice",
  "description": "C 语言 + 数据结构在线学习平台（知识点 / 可视化演示 / 在线刷题），纯静态站点",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "acceptance:cc": "node scripts/acceptance-cc.ts",
    "acceptance:dbg": "node scripts/acceptance-dbg.ts",
    "acceptance:dbg-ui": "node scripts/acceptance-dbg-ui.mjs",
    "acceptance:list-ui": "node scripts/acceptance-list-ui.mjs",
    "acceptance:progress-ui": "node scripts/acceptance-progress-ui.mjs",
    "acceptance:site-ui": "node scripts/acceptance-site-ui.mjs",
    "acceptance:viz-ui": "node scripts/acceptance-viz-ui.mjs",
    "build": "tsc -b && vite build",
    "backfill:viz": "node scripts/backfill-viz-links.ts",
    "build:index": "node scripts/build-index.ts",
    "dev": "vite",
    "gen:viz": "node scripts/gen-viz.ts",
    "judge:verify": "node scripts/judge-verify.ts",
    "lint:code": "node scripts/lint-code.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:data": "node scripts/verify-data.ts",
    "verify:pages": "node scripts/verify-pages-dist.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
