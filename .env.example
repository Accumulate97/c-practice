# 复制为 .env.local 后按需覆盖。全部为可选，缺省即按 ADR-0001 的现役配置运行。

# 编译后端：目前只有 godbolt 一个实现。
# piston 已于 2026-02-15 起白名单化（实测 execute 返回 401），judge0 需要 API key
# 而纯静态站无法隐藏 key，故两者都未写实现；填未知值会回落 godbolt 并告警。
# 新增后端的契约与步骤见 src/judge/index.ts，选型依据见 docs/adr/0001-judge-backend.md
VITE_JUDGE_BACKEND=godbolt

# Godbolt 编译器 id，默认 cg132 = GCC 13.2 x86-64
VITE_GODBOLT_COMPILER=cg132

# libm 支路的编译器 id，默认 cicc191 = x86-64 icc 19.0.1。
# cg132 的执行链路不吃 userArguments 里的 -lm，含 sqrt 一类数学函数的代码必然
# undefined reference；构建期与线上判分都按 needsMathLib() 把这类代码分流到本编译器。
# 为什么不是 g132（它是 C++ 前端，会拒绝 malloc 不强转 / _Bool 等合法 C 写法）：
# 实测表格见 src/judge/math-lib.ts 文件头。
VITE_GODBOLT_MATH_COMPILER=cicc191

# 判分后端容灾梯队（ADR-0002）。默认开启：主编译器（VITE_GODBOLT_COMPILER）失败时
# 依次尝试下列 Godbolt 编译器 id，学生侧无感；全链不可用才落入降级自评模式。
# 为什么梯队只在 Godbolt 内部：第三方公共 API 本轮实测均不可用——
# Piston POST /execute 返回 401（2026-02-15 起白名单制），Wandbox 返回 500（Failed to get uid），
# 判分口径也只能用 -std=c99 -Wall -Wextra 对齐，跨厂商无法保证同一份答案同样判定。
# 填 off 关闭容灾（回到单点主编译器）；填 id 列表则覆盖默认梯队。
VITE_JUDGE_FAILOVER=on
VITE_GODBOLT_FAILOVER=cg142,cg131
